# ─────────────────────────────────────────────────────────────────────────
# Variables d'environnement Madger
# Copie ce fichier en .env.local (jamais commité) pour le dev, et renseigne
# les mêmes clés dans Vercel → Settings → Environment Variables pour la prod.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase (déjà utilisé par la landing) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# NOUVEAU pour l'app (auth côté navigateur) — Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Emails transactionnels (déjà utilisé par la landing) ────────────────
RESEND_API_KEY=

# ── URL publique de l'app (pour les liens, redirections OAuth, etc.) ─────
NEXT_PUBLIC_APP_URL=https://madger.app

# ── Auth Google (Phase 1) ───────────────────────────────────────────────
# Le Client ID / Secret se renseignent dans Supabase → Auth → Providers →
# Google. Ces variables servent à l'accès Calendar/Meet (Phase 4).

# ── Google Calendar + Meet (Phase 4) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe Connect (Phase 4) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Second endpoint Stripe « comptes connectés » (account.updated) : optionnel, sans lui le dashboard rafraîchit l'état Stripe du coach à l'affichage
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── Envoi des codes promo aux membres early access (au lancement) ────────
# Secret protégeant POST /api/admin/send-promo-codes (Authorization: Bearer)
PROMO_SEND_SECRET=

# ── Exploitation (obligatoires en production) ────────────────────────────
# Interrupteur de lancement : 1 = site ouvert (sinon verrou d'accès jusqu'à
# l'heure de lib/launch.ts, qui ouvre seule le jour J)
SITE_LAUNCHED=0
# Code du verrou d'accès avant lancement (repli : valeur de lib/access.ts)
APP_ACCESS_CODE=
# Jeton des crons (Vercel et cron-job.org) : Authorization: Bearer <valeur>
CRON_SECRET=
# Emails autorisés sur /admin et /api/admin/*, séparés par des virgules
ADMIN_EMAILS=
# Adresse qui reçoit les alertes des crons et des webhooks
FOUNDER_EMAIL=
# Places fondateurs de l'accès anticipé (repli : 50)
FOUNDER_CAP=50

# ── Optionnelles ─────────────────────────────────────────────────────────
# Analytics PostHog (navigateur et serveur) ; sans clé, rien n'est envoyé
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=
POSTHOG_API_HOST=
# Génération de textes (bio, descriptions) : sans clé, la fonction est masquée
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
